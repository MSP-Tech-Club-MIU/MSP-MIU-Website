# ============================================
# MSP MIU Website - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!
# Full reference: docs/environment.md

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
# Log verbosity: debug | info | warn | error | fatal | silent
# Defaults to debug in development, info in production when unset
LOG_LEVEL=info
# Optional: max in-memory log entries for the admin Logs viewer (50–5000, default 500)
# LOG_BUFFER_SIZE=500

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=msp_miu_db
DB_USER=your_db_username
DB_PASS=your_db_password
# Prefer schema patch scripts over alter sync (see docs/scripts-and-ops.md)
# DB_SYNC_ALTER=false

# ============================================
# JWT Authentication
# ============================================
# MUST be at least 16 characters long
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_minimum_16_characters_long
JWT_EXPIRES_IN=24h

# ============================================
# Email Configuration (Nodemailer — MAIL_* not SMTP_*)
# ============================================
# Gmail: use an App Password with 2FA enabled
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_or_email_password
MAIL_FROM_ADDRESS=noreply@msp-miu.tech
# HMAC secret for unsubscribe links (falls back to JWT_SECRET)
# EMAIL_UNSUBSCRIBE_SECRET=
# Paced bulk sends (announcements / Android / competition broadcasts)
# MAIL_BULK_DELAY_MS=800
# MAIL_BULK_BATCH_SIZE=40
# MAIL_BULK_BATCH_PAUSE_MS=15000

# ============================================
# Website URLs
# ============================================
FRONTEND_URL=https://msp-miu.tech
WEBSITE_URL=https://msp-miu.tech
# Public API base for unsubscribe links (optional; defaults from WEBSITE_URL / FRONTEND_URL)
# API_PUBLIC_URL=https://msp-miu.tech
# Optional override for WhatsApp / Facebook / Twitter / LinkedIn previews
# OG_IMAGE_URL=https://msp-miu.tech/og-image.png

# ============================================
# Cloudflare R2 (optional; falls back to server/uploads/)
# ============================================
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_DOMAIN=https://cdn.example.com
# R2_TLS_INSECURE=false

# ============================================
# Judging / evaluation (optional)
# ============================================
# JUDGE_BOARD_POSITIONS=President,Vice President,Head,Co-Head
# JUDGE_BOARD_DEPARTMENT_IDS=
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# QUIZ_DEBUG=false

# ============================================
# Email template extras (optional)
# ============================================
# YOUTUBE_URL=https://www.youtube.com/@MSP-MIU
# INSTAGRAM_URL=https://www.instagram.com/mspmiu
# TIKTOK_URL=https://www.tiktok.com/@mspmiu
# COURSE_NAME=
# FEEDBACK_FORM_URL=
# GITHUB_COPILOT_LEARNING_PATH_URL=
# LOGO_URL=

# ============================================
# Client (Vite) — set in client/.env for local builds
# ============================================
# VITE_DEVELOPMENT_API_URL=http://localhost:3000/api
# VITE_PRODUCTION_API_URL=https://msp-miu.tech/api
# VITE_R2_PUBLIC_DOMAIN=https://cdn.example.com
